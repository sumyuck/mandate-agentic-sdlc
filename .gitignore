# ---- Source material ----
# Deliberately not committed: the brief this was built against is not ours to publish.
*.pdf
*.docx

# ---- .NET ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
# Anchored to the repository root on purpose. Unanchored, this pattern also matches
# source directories named Artifacts/, and on a case-insensitive filesystem it silently
# excluded the artifact domain model from the repository.
/artifacts/
*.user
*.suo
project.lock.json
TestResults/
coverage*.xml
coverage*.json
*.coverage
*.trx

# ---- Mandate runtime state ----
# Durable run state + per-run git workspaces are machine-local.
# Curated run EVIDENCE is committed under runs/ instead.
.mandate/
!runs/**

# ---- Secrets ----
.env
.env.*
!.env.example
appsettings.Local.json
*.pfx
*.key

# ---- Tooling / OS ----
.vs/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
node_modules/

# Internal working notes, not part of the submission.
HANDOFF.md

# Internal build plan, not part of the submission.
PLAN.md

