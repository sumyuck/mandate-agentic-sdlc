# ---- Source material ----
# Deliberately not committed: the brief this was built against is not ours to publish.
*.pdf
*.docx

# ---- .NET ----
bin/
obj/
# Every one of these is anchored or specific on purpose. An unanchored directory pattern
# also matches source directories of the same name: `artifacts/` once swallowed
# src/Mandate.Core/Artifacts/, and on a case-insensitive filesystem `git add` skipped it
# without a word, so the repository did not compile from a clean clone. Build output
# already lives under bin/ and obj/, so nothing is lost by being strict here.
# scripts/check-sources-tracked.sh fails the build if this happens again.
/artifacts/
*.user
*.suo
project.lock.json
TestResults/
coverage*.xml
coverage*.json
*.coverage
*.trx

# ---- Mandate runtime state ----
# Durable run state + per-run git workspaces are machine-local.
# Curated run EVIDENCE is committed under runs/ instead.
.mandate/
!runs/**

# ---- Secrets ----
.env
.env.*
!.env.example
appsettings.Local.json
*.pfx
*.key

# ---- Tooling / OS ----
.vs/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
node_modules/

# Internal working notes, not part of the submission.
HANDOFF.md

# Internal build plan, not part of the submission.
PLAN.md

# Draft deck, still in progress.
docs/Mandate-Overview.pptx
