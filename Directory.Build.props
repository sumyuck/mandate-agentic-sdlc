<Project>

  <!--
    Central build configuration for the whole solution.

    Target framework is declared in ONE place. .NET 10 is the current LTS release
    (supported to November 2028); .NET 8 leaves support on 10 November 2026. In a regulated
    domain the support lifecycle is a compliance input, not a preference, so a greenfield
    system targets the current LTS. No project declares its own TargetFramework, which makes
    a retarget a one-line change here. See docs/adr/0002.
  -->
  <PropertyGroup>
    <MandateTargetFramework>net10.0</MandateTargetFramework>
    <TargetFramework>$(MandateTargetFramework)</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Quality gates enforced by the compiler, not by convention. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Reproducible builds: identical inputs must produce identical outputs. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Muskan Jain</Authors>
    <Product>Mandate</Product>
    <Company>Mandate</Company>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
