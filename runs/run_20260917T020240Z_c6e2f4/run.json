      "key": "requirements.scope",
      "value": "Add per-client rate limiting (fixed window, 60 requests/minute, keyed by API key or falling back to client IP) to POST /api/v1/links, returning 429 with Retry-After when exceeded, backed by in-process counters only.",
      "revisions": 2
    },
