<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mandate.Core\Mandate.Core.csproj" />
    <ProjectReference Include="..\Mandate.Orchestrator\Mandate.Orchestrator.csproj" />
    <ProjectReference Include="..\Mandate.Agents\Mandate.Agents.csproj" />
    <ProjectReference Include="..\Mandate.Policy\Mandate.Policy.csproj" />
    <ProjectReference Include="..\Mandate.Persistence\Mandate.Persistence.csproj" />
    <ProjectReference Include="..\Mandate.Observability\Mandate.Observability.csproj" />
    <ProjectReference Include="..\Mandate.Llm\Mandate.Llm.csproj" />
    <ProjectReference Include="..\Mandate.Workflows\Mandate.Workflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The commands are internal: they are the CLI's own surface, not a library API. The test
      project drives the same command definitions the binary exposes, so what is tested is
      what ships.
    -->
    <InternalsVisibleTo Include="Mandate.Cli.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mandate</AssemblyName>
    <RootNamespace>Mandate.Cli</RootNamespace>
  </PropertyGroup>

</Project>
